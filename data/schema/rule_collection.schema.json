{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopee-br-compliance-agent.local/schema/rule_collection.schema.json",
  "title": "Rule Collection",
  "description": "A file under rules/ holding one or more rules plus its provenance metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["rules"],
  "properties": {
    "schema_version": {"type": "string"},
    "library": {"type": "string"},
    "source_tier": {
      "type": "string",
      "enum": ["platform_official", "law", "internal_risk", "unverified"]
    },
    "source_url": {"type": "string", "format": "uri"},
    "source_excerpt": {"type": "string"},
    "last_verified": {"type": "string", "format": "date"},
    "notes": {"type": "string"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "rule.schema.json"}
    }
  }
}
