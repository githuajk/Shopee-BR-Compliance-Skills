{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopee-br-compliance-agent.local/schema/rule.schema.json",
  "title": "Compliance Rule",
  "description": "One reviewable rule in the Shopee BR compliance rule library. A rule states a condition that can be detected on a listing, what the platform/law requires, and what the agent must conclude.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id",
    "title",
    "category",
    "description",
    "trigger_conditions",
    "severity",
    "decision",
    "evidence_required",
    "human_review_required",
    "source_url",
    "last_verified",
    "status",
    "version"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "pattern": "^SBR-[A-Z]{2,4}-[0-9]{3,4}$",
      "description": "Stable unique identifier. SBR = Shopee BR. Category prefix + serial."
    },
    "title": {
      "type": "string",
      "minLength": 4,
      "maxLength": 200
    },
    "category": {
      "type": "string",
      "enum": [
        "prohibited_item",
        "restricted_item",
        "listing_violation",
        "duplicate_listing",
        "cross_store_duplicate",
        "ip_trademark",
        "ip_copyright",
        "ip_design",
        "authorization",
        "relist_freeze",
        "account_penalty",
        "consumer_protection",
        "internal_risk"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "description": "What the rule checks and why it matters. Plain statement of the requirement."
    },
    "trigger_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "operator", "value"],
        "properties": {
          "field": {
            "type": "string",
            "enum": [
              "title",
              "description",
              "attributes",
              "category",
              "brand",
              "model",
              "price",
              "image",
              "image_text",
              "variations",
              "seller_name",
              "supplier_sku",
              "shop_id",
              "product_url",
              "history",
              "any_text"
            ]
          },
          "operator": {
            "type": "string",
            "enum": [
              "contains_any",
              "contains_all",
              "regex",
              "not_contains_any",
              "equals",
              "not_equals",
              "gt",
              "gte",
              "lt",
              "lte",
              "image_count_lt",
              "image_count_gte",
              "has_field",
              "has_nonempty",
              "field_missing"
            ]
          },
          "value": {
            "description": "Operand. For regex operators this is the pattern string; for list operators an array of strings; for numeric operators a number; for has_field/field_missing it is the field name that must be present/absent.",
            "oneOf": [
              {"type": "string"},
              {"type": "number"},
              {"type": "array", "items": {"type": "string"}},
              {"type": "boolean"}
            ]
          },
          "case_sensitive": {"type": "boolean", "default": false},
          "requires_input": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Fields that must actually be present in the input for this condition to be evaluated. If one is absent, the condition is skipped (the input simply did not carry that data) instead of producing a finding."
          },
          "applies_to": {
            "type": "array",
            "items": {"type": "string", "enum": ["title", "description", "attributes", "image", "all"]},
            "default": ["all"]
          }
        }
      }
    },
    "severity": {
      "type": "string",
      "enum": ["info", "low", "medium", "high", "critical"]
    },
    "decision": {
      "type": "string",
      "enum": [
        "allow",
        "flag_for_review",
        "require_evidence",
        "block",
        "freeze_relist",
        "escalate_legal"
      ],
      "description": "The agent's action when the rule fires."
    },
    "evidence_required": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Evidence artefacts (by evidence_type key) needed to close the case."
    },
    "human_review_required": {"type": "boolean"},
    "source_url": {
      "type": "string",
      "format": "uri",
      "minLength": 8
    },
    "source_tier": {
      "type": "string",
      "enum": ["platform_official", "law", "internal_risk", "unverified"],
      "description": "Authority of the source. `unverified` means the rule is a hypothesis pending confirmation and MUST NOT be applied to block decisions."
    },
    "source_excerpt": {
      "type": "string",
      "description": "Verbatim quote (or close paraphrase marked as such) from the source supporting this rule."
    },
    "applies_to": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Scope notes: product categories, seller types, or 'all'."
    },
    "last_verified": {
      "type": "string",
      "format": "date",
      "description": "Date the rule text was last checked against its source."
    },
    "status": {
      "type": "string",
      "enum": ["active", "draft", "deprecated", "suspended"]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "notes": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "references": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Other rule_ids this rule interacts with."
    }
  }
}
