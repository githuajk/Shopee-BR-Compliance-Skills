{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopee-br-compliance-agent.local/schema/review_result.schema.json",
  "title": "Review Result",
  "description": "Output of one compliance review run over a set of products.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "generated_at", "summary", "findings", "products"],
  "properties": {
    "run_id": {"type": "string", "minLength": 4},
    "generated_at": {"type": "string"},
    "scope": {
      "type": "object",
      "additionalProperties": true,
      "description": "Which inputs were reviewed: source files, shops, date range."
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["products_reviewed", "products_flagged", "products_blocked", "findings_total"],
      "properties": {
        "products_reviewed": {"type": "integer", "minimum": 0},
        "products_flagged": {"type": "integer", "minimum": 0},
        "products_blocked": {"type": "integer", "minimum": 0},
        "products_awaiting_review": {"type": "integer", "minimum": 0},
        "findings_total": {"type": "integer", "minimum": 0},
        "by_category": {"type": "object", "additionalProperties": {"type": "integer"}},
        "by_severity": {"type": "object", "additionalProperties": {"type": "integer"}},
        "by_decision": {"type": "object", "additionalProperties": {"type": "integer"}},
        "rules_evaluated": {"type": "integer", "minimum": 0},
        "parse_errors": {"type": "integer", "minimum": 0}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "product_id", "rule_id", "severity", "decision", "explanation"],
        "properties": {
          "finding_id": {"type": "string", "minLength": 4},
          "product_id": {"type": "string", "minLength": 4},
          "shop_id": {"type": ["string", "null"]},
          "rule_id": {"type": "string"},
          "rule_title": {"type": "string"},
          "category": {"type": "string"},
          "severity": {"type": "string", "enum": ["info", "low", "medium", "high", "critical"]},
          "decision": {"type": "string", "enum": ["allow", "flag_for_review", "require_evidence", "block", "freeze_relist", "escalate_legal"]},
          "matched_field": {"type": ["string", "null"]},
          "matched_excerpt": {"type": ["string", "null"], "description": "The exact snippet that triggered the rule."},
          "explanation": {"type": "string", "minLength": 5},
          "source_url": {"type": ["string", "null"]},
          "source_tier": {"type": ["string", "null"]},
          "human_review_required": {"type": "boolean"},
          "evidence_required": {"type": "array", "items": {"type": "string"}},
          "confidence": {
            "type": "string",
            "enum": ["signal", "likely", "confirmed"],
            "description": "`signal` = pattern matched but context unknown; `confirmed` = the rule condition is deterministically met. NEVER use `confirmed` for an IP finding derived only from keyword/logo matching."
          }
        }
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product_id", "status", "finding_ids"],
        "properties": {
          "product_id": {"type": "string"},
          "shop_id": {"type": ["string", "null"]},
          "internal_sku": {"type": ["string", "null"]},
          "title": {"type": ["string", "null"]},
          "status": {"type": "string", "enum": ["pass", "flag", "block", "frozen", "error"]},
          "finding_ids": {"type": "array", "items": {"type": "string"}},
          "recommended_action": {"type": "string"},
          "case_id": {"type": ["string", "null"]}
        }
      }
    },
    "errors": {
      "type": "array",
      "description": "Parse failures and missing-data reports. Never silently dropped.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "message"],
        "properties": {
          "stage": {"type": "string"},
          "source": {"type": ["string", "null"]},
          "message": {"type": "string"},
          "severity": {"type": "string", "enum": ["warning", "error"]},
          "context": {"type": ["object", "null"], "additionalProperties": true}
        }
      }
    },
    "report_path": {"type": ["string", "null"], "description": "Markdown report written for this run."}
  }
}
