{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopee-br-compliance-agent.local/schema/case.schema.json",
  "title": "Case",
  "description": "A compliance case: one product undergoing review, or one platform violation notice being tracked.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "shop_id",
    "product_ids",
    "violation_type",
    "status",
    "frozen",
    "evidence",
    "approvals"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^SBRC-[0-9]{6,}$",
      "description": "Stable unique case id."
    },
    "shop_id": {"type": "string", "minLength": 1},
    "product_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "description": "Products under review (product_id values)."
    },
    "case_type": {
      "type": "string",
      "enum": ["listing_review", "platform_notice", "relist_check", "duplicate_check", "ip_complaint", "authorization_review"],
      "default": "listing_review"
    },
    "violation_type": {
      "type": "string",
      "description": "Free-form but controlled: prefer a rule_id from the rule library when one applies."
    },
    "rule_ids": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Rules that fired for this case."
    },
    "platform_notice": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "description": "Verbatim platform notification payload: source system, notice id, received_at, quoted reason, severity, appeal deadline."
    },
    "status": {
      "type": "string",
      "enum": ["open", "under_review", "awaiting_evidence", "blocked", "relist_frozen", "approved", "rejected", "closed", "escalated"]
    },
    "frozen": {
      "type": "boolean",
      "description": "True when the product must not be re-published without a fresh approval."
    },
    "freeze_reason": {"type": ["string", "null"]},
    "freeze_until": {"type": ["string", "null"], "format": "date"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_type", "provided"],
        "properties": {
          "evidence_type": {"type": "string", "minLength": 2},
          "provided": {"type": "boolean"},
          "artifact_ref": {"type": ["string", "null"]},
          "notes": {"type": "string"},
          "collected_at": {"type": "string"}
        }
      }
    },
    "evidence_gaps": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Required evidence that is missing."
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "actor", "timestamp"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["submit", "approve", "reject", "request_evidence", "escalate", "unfreeze", "note", "appeal"]
          },
          "actor": {"type": "string"},
          "timestamp": {"type": "string"},
          "reason": {"type": "string"},
          "decision_ref": {"type": ["string", "null"]}
        }
      }
    },
    "assessment": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "description": "Engine result summary for this case."
    },
    "duplicate_of": {
      "type": ["string", "null"],
      "description": "product_id of the canonical listing when this case is a duplicate."
    },
    "related_case_ids": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  }
}
