{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopee-br-compliance-agent.local/contracts/evidence_reference.schema.json",
  "title": "EvidenceReference",
  "description": "证据引用。只存引用与元信息，不存凭证内容。",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "evidence_type", "provided"],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 4},
    "evidence_type": {
      "type": "string",
      "minLength": 2,
      "description": "证据类型键。与规则的 evidence_required 对应。",
      "examples": [
        "anvisa_registration",
        "anatel_registration",
        "inmetro_certificate",
        "mapa_registration",
        "homologation_certificate",
        "pharmacy_license",
        "brand_authorization_letter",
        "supplier_invoice",
        "distribution_authorization",
        "sanitary_registration",
        "product_photographs",
        "product_measurements",
        "manufacturer_claim_reference",
        "image_review",
        "licence_document",
        "case_id",
        "platform_notice",
        "penalty_points_summary",
        "appeal_record",
        "remediation_evidence",
        "approval_record",
        "canonical_listing_id",
        "variant_rationale",
        "master_sku_assignment"
      ]
    },
    "provided": {
      "type": "boolean",
      "description": "是否已提供。false 表示需要补齐。"
    },
    "artifact_ref": {
      "type": ["string", "null"],
      "description": "引用（路径或外部工单号）。禁止内嵌完整凭证或授权文件内容。"
    },
    "source_locator": {
      "type": ["string", "null"],
      "description": "原始定位，如 'row 42'、'line 7'、'sheet1!C7'。"
    },
    "collected_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "notes": {"type": ["string", "null"]}
  }
}
