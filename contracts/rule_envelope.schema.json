{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopee-br-compliance-agent.local/contracts/rule_envelope.schema.json",
  "title": "RuleEnvelope",
  "description": "规则的统一外层格式。所有模块引用规则时使用本结构。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id",
    "title",
    "category",
    "description",
    "severity",
    "action",
    "source",
    "status",
    "version",
    "evidence_required",
    "requires_human_review"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "pattern": "^SBR-[A-Z]{2,4}-[0-9]{3,4}$",
      "description": "稳定 ID。一经发布不得复用或改指。"
    },
    "title": {
      "type": "string",
      "minLength": 4
    },
    "category": {
      "type": "string",
      "enum": [
        "prohibited_item",
        "restricted_item",
        "listing_violation",
        "consumer_protection",
        "duplicate_listing",
        "cross_store_duplicate",
        "relist_freeze",
        "authorization",
        "account_penalty",
        "ip_trademark",
        "ip_copyright",
        "ip_design",
        "ip_patent",
        "internal_risk"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "allow",
        "flag_for_review",
        "require_evidence",
        "revise",
        "block",
        "freeze_relist",
        "escalate_legal"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "url",
        "last_verified"
      ],
      "description": "来源与核查信息。excerpt 必须在 research/raw/ 的抓取件中逐字可核验。",
      "properties": {
        "tier": {
          "type": "string",
          "enum": [
            "platform_official",
            "law",
            "internal_risk",
            "unverified",
            "ai_inference",
            "technical"
          ]
        },
        "url": {
          "type": "string",
          "minLength": 8
        },
        "excerpt": {
          "type": [
            "string",
            "null"
          ],
          "description": "原文引文。必须逐字出现在 research/raw/*.txt 中；核验工具 tools/verify_citations.py。"
        },
        "last_verified": {
          "type": "string",
          "format": "date"
        },
        "article_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "平台文章的编号（如 5139），便于定位。"
        },
        "platform_code": {
          "type": [
            "string",
            "null"
          ],
          "description": "平台违规码（如 [337]）。"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "draft",
        "deprecated",
        "suspended"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "evidence_required": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      },
      "description": "关闭该案件所需的证据类型键。"
    },
    "requires_human_review": {
      "type": "boolean"
    },
    "applies_to": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "适用范围（品类、卖家类型）。空或缺省表示全部。"
    },
    "trigger_conditions": {
      "type": "array",
      "description": "触发条件。全部为 AND 关系。requires_input 声明依赖的输入字段；字段缺失则该条件不评估（契约 H3）。",
      "items": {
        "type": "object",
        "required": [
          "field",
          "operator"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "operator": {
            "type": "string",
            "enum": [
              "contains_any",
              "contains_all",
              "not_contains_any",
              "regex",
              "equals",
              "not_equals",
              "gt",
              "gte",
              "length_lt",
              "lt",
              "lte",
              "image_count_lt",
              "image_count_gte",
              "has_field",
              "has_nonempty",
              "field_missing",
              "history_missing_nonempty"
            ]
          },
          "value": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "case_sensitive": {
            "type": "boolean",
            "default": false
          },
          "requires_input": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "依赖的输入字段。任一缺失则条件不评估并上报未评估。"
          }
        }
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner_module": {
      "type": [
        "string",
        "null"
      ],
      "description": "负责维护该规则的模块。"
    }
  }
}
