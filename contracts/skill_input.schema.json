{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopee-br-compliance-agent.local/contracts/skill_input.schema.json",
  "title": "SkillInput",
  "description": "所有 Skill 的统一输入格式。模块只依赖本契约，不依赖调用方实现。",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "task_type", "target", "provenance"],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 4,
      "description": "本次请求的唯一标识，用于串联多模块结果。"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "policy_research",
        "listing_audit",
        "duplicate_detection",
        "ip_review",
        "ingestion",
        "reporting",
        "orchestration"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["product_batch", "rule_library", "data_source", "case_history", "audit_result_set", "source_document"]
        },
        "ref": {
          "type": ["string", "null"],
          "description": "目标对象的引用（路径、ID 或 URL）。"
        },
        "count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "目标对象数量。"
        }
      }
    },
    "products": {
      "type": "array",
      "default": [],
      "description": "商品数组。结构遵循 data/schema/product.schema.json 的字段命名；本契约只约束容器与必需标识。",
      "items": {
        "type": "object",
        "required": ["product_id", "internal_sku", "shop_id", "title"],
        "properties": {
          "product_id": {"type": "string", "minLength": 4},
          "internal_sku": {"type": "string", "minLength": 1},
          "supplier_sku": {"type": ["string", "null"]},
          "shop_id": {"type": "string", "minLength": 1},
          "shop_name": {"type": ["string", "null"]},
          "platform_pid": {"type": ["string", "null"]},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "default": ""},
          "attributes": {"type": "object", "additionalProperties": true},
          "category": {"type": ["string", "null"]},
          "brand": {"type": ["string", "null"]},
          "model": {"type": ["string", "null"]},
          "price": {"type": ["number", "null"]},
          "currency": {"type": "string", "default": "BRL"},
          "images": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
          "variations": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
          "product_url": {"type": ["string", "null"]},
          "history": {"type": "object", "additionalProperties": true},
          "case_ids": {"type": "array", "items": {"type": "string"}},
          "source": {"type": "object", "additionalProperties": true}
        }
      }
    },
    "cases": {
      "type": "array",
      "default": [],
      "description": "历史案件数组。结构遵循 data/schema/case.schema.json。",
      "items": {
        "type": "object",
        "required": ["case_id", "shop_id", "product_ids", "violation_type", "status", "frozen"],
        "properties": {
          "case_id": {"type": "string", "minLength": 4},
          "shop_id": {"type": "string"},
          "product_ids": {"type": "array", "items": {"type": "string"}},
          "violation_type": {"type": "string"},
          "status": {
            "type": "string",
            "enum": ["open", "under_review", "awaiting_evidence", "blocked", "relist_frozen", "approved", "rejected", "closed", "escalated"]
          },
          "frozen": {"type": "boolean"},
          "rule_ids": {"type": "array", "items": {"type": "string"}},
          "platform_notice": {"type": ["object", "null"], "additionalProperties": true},
          "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
          "approvals": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
        }
      }
    },
    "rules": {
      "type": "array",
      "default": [],
      "description": "规则数组。结构遵循 contracts/rule_envelope.schema.json。",
      "items": {"$ref": "rule_envelope.schema.json"}
    },
    "scope": {
      "type": "object",
      "additionalProperties": true,
      "description": "生效范围。",
      "properties": {
        "shop_ids": {"type": "array", "items": {"type": "string"}},
        "categories": {"type": "array", "items": {"type": "string"}},
        "date_from": {"type": ["string", "null"], "format": "date"},
        "date_to": {"type": ["string", "null"], "format": "date"}
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": true,
      "description": "模块特定开关。模块只读取自己认识的键，未知键必须忽略而非报错。"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "produced_at"],
      "description": "溯源信息。缺失溯源的输入不得进入审核链路。",
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "description": "输入来源清单。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "kind": {"type": "string"},
              "digest": {"type": ["string", "null"], "description": "内容哈希（SHA-256 十六进制）。"},
              "parsed_at": {"type": ["string", "null"]},
              "parser_version": {"type": ["string", "null"]},
              "records_parsed": {"type": ["integer", "null"], "minimum": 0},
              "records_failed": {"type": ["integer", "null"], "minimum": 0}
            }
          }
        },
        "produced_at": {"type": "string", "format": "date-time"},
        "producer": {"type": ["string", "null"], "description": "产出者（模块名 + 版本）。"}
      }
    }
  }
}
