{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopee-br-compliance-agent.local/contracts/module_handoff.schema.json",
  "title": "ModuleHandoff",
  "description": "模块之间的交接格式。平台不保证 Skill 自动调用，因此交接是显式的文件级约定，不是运行时调用。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handoff_id", "from_module", "to_module", "request_id",
    "contract_version", "produced_at", "assumptions", "known_gaps"
  ],
  "properties": {
    "handoff_id": {"type": "string", "minLength": 4},
    "from_module": {"type": "string", "minLength": 1},
    "to_module": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 4},
    "payload_ref": {
      "type": ["object", "null"],
      "description": "载荷引用。推荐用 artifact_ref 指向文件，避免大对象内联。",
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {"type": ["string", "null"]},
        "inline": {"type": ["object", "null"], "additionalProperties": true},
        "record_count": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "契约版本。语义化。"
    },
    "produced_at": {"type": "string", "format": "date-time"},
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "description": "本模块做出的假设。必填 —— 下游必须知道结论建立在什么前提上。"
    },
    "known_gaps": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "description": "已知缺口。必填 —— 不得让下游误以为结果完整。"
    },
    "unevaluated": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["rule_id", "reason"],
        "properties": {
          "rule_id": {"type": "string"},
          "reason": {"type": "string"},
          "missing_fields": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "requires_human_review": {
      "type": "boolean",
      "default": false,
      "description": "本次交接是否整体需要人工复核。"
    }
  }
}
