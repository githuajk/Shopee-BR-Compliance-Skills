{
  "schema_version": "1.0",
  "name": "Shopee BR — 葡语动词变位匹配表",
  "description": "葡语动词必须匹配全部变位，否则大量漏检。模式用 \\b 包裹，但注意葡语 \\b 不可靠 —— 见 SOP §4.2。",
  "last_updated": "2026-10-27",
  "entries": [
    {
      "lemma": "proporcionar",
      "match_pattern": "(?<![a-zA-Zà-ÿÀ-ß])proporciona\\w*(?![a-zA-Zà-ÿÀ-ß])",
      "plain_pattern": "\\bproporciona\\w*\\b",
      "forms": [
        "proporciona",
        "proporcionam",
        "proporcionei",
        "proporcionou",
        "proporcionaram",
        "proporcionando",
        "proporcionado",
        "proporcionada",
        "proporciono",
        "proporcionamos"
      ],
      "exclude": [
        "\\bproporcional\\b",
        "\\bproporcional\\w*\\b"
      ],
      "note": "坑 3：proporcional 是中性形容词，不能命中。"
    },
    {
      "lemma": "assegurar",
      "match_pattern": "(?<![a-zA-Zà-ÿÀ-ß])assegur\\w*(?![a-zA-Zà-ÿÀ-ß])",
      "plain_pattern": "\\bassegur\\w*\\b",
      "forms": [
        "assegura",
        "asseguram",
        "assegurei",
        "assegurou",
        "assegurando",
        "assegurado",
        "assegurada",
        "asseguro"
      ],
      "exclude": [],
      "note": "坑 4：ass... 系列要用 \\w* 覆盖。"
    },
    {
      "lemma": "garantir",
      "match_pattern": "(?<![a-zA-Zà-ÿÀ-ß])garantid[oa](?![a-zA-Zà-ÿÀ-ß])",
      "plain_pattern": "\\bgarantid[oa]\\b",
      "forms": [
        "garante",
        "garantem",
        "garanti",
        "garantindo",
        "garantido",
        "garantida",
        "garantimos",
        "garantiu"
      ],
      "exclude": [
        "(?<![a-zA-Zà-ÿÀ-ß])garantir\\s+(?:o\\s+)?conforto(?![a-zA-Zà-ÿÀ-ß])"
      ],
      "note": "坑 6：描述性用法『garantir conforto』是误杀（121 个），只匹配承诺用法。"
    },
    {
      "lemma": "substituir",
      "match_pattern": "(?<![a-zA-Zà-ÿÀ-ß])substitu\\w+(?![a-zA-Zà-ÿÀ-ß])",
      "plain_pattern": "\\bsubstitu\\w+\\b",
      "forms": [
        "substitui",
        "substituem",
        "substituindo",
        "substituído",
        "substituída"
      ],
      "exclude": [],
      "note": "坑 5。"
    },
    {
      "lemma": "tratar",
      "match_pattern": "(?<![a-zA-Zà-ÿÀ-ß])trat\\w+(?![a-zA-Zà-ÿÀ-ß])",
      "plain_pattern": "\\btrat\\w+\\b",
      "forms": [
        "trata",
        "tratam",
        "tratou",
        "tratando",
        "tratado",
        "trato"
      ],
      "exclude": [],
      "note": "注意『tratamento』在某些语境允许（慎用）。"
    },
    {
      "lemma": "curar",
      "match_pattern": "(?<![a-zA-Zà-ÿÀ-ß])cur\\w+(?![a-zA-Zà-ÿÀ-ß])",
      "plain_pattern": "\\bcur\\w+\\b",
      "forms": [
        "cura",
        "curam",
        "curou",
        "curando",
        "curado"
      ],
      "exclude": [],
      "note": ""
    },
    {
      "lemma": "eliminar",
      "match_pattern": "(?<![a-zA-Zà-ÿÀ-ß])elimina\\w*(?![a-zA-Zà-ÿÀ-ß])",
      "plain_pattern": "\\belimina\\w*\\b",
      "forms": [
        "elimina",
        "eliminam",
        "eliminando",
        "eliminado",
        "eliminada"
      ],
      "exclude": [],
      "note": ""
    }
  ],
  "case_insensitive_prefix_rule": "大小写同时匹配时用 [Pp]ara 保证 形式：r'[Pp]ara garantir\\b'",
  "accent_folding": "NFD 归一化后去除组合附加符（Ã→A），Ç 保留。"
}